# Application
APP_NAME="GHL UI Skin API"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_API_KEY=your-admin-api-key-here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=redis://default:xxxxx@upstash-redis.com:6379

# CORS Origins (GHL domains)
CORS_ORIGINS=https://app.gohighlevel.com,https://app.leadconnectorhq.com

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080  # 7 days

# CDN Configuration
CDN_BASE_URL=https://cdn.tudominio.com

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Cache TTL (seconds)
CACHE_CONFIG_TTL=300  # 5 minutes
