# Variables de entorno para servicios de scraping
# Copia este archivo a .env y completa tus credenciales

# ═══════════════════════════════════════════════════════════
# ScraperAPI (https://www.scraperapi.com)
# ═══════════════════════════════════════════════════════════
# Costo: Desde $49/mes (100K requests)
# Ventajas: Fácil de usar, buen precio
# Registro: https://www.scraperapi.com/signup

SCRAPERAPI_KEY=your_scraperapi_key_here

# ═══════════════════════════════════════════════════════════
# Bright Data (https://brightdata.com)
# ═══════════════════════════════════════════════════════════
# Costo: Desde $500/mes (más flexible, pay-as-you-go disponible)
# Ventajas: Más robusto, mejor para escala
# Registro: https://brightdata.com/cp/start

BRIGHTDATA_USERNAME=your_brightdata_username_here
BRIGHTDATA_PASSWORD=your_brightdata_password_here

# ═══════════════════════════════════════════════════════════
# Apify (https://apify.com)
# ═══════════════════════════════════════════════════════════
# Costo: Desde $49/mes, tier gratis disponible
# Ventajas: Muy fácil, tier gratis generoso
# Registro: https://console.apify.com/sign-up

APIFY_TOKEN=your_apify_token_here

# ═══════════════════════════════════════════════════════════
# Configuración del sistema
# ═══════════════════════════════════════════════════════════

# Servicio preferido (scraperapi, brightdata, apify, direct)
DEFAULT_SCRAPING_SERVICE=scraperapi
